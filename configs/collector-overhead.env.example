# Copy to configs/collector-overhead.env. The real file is gitignored because
# it contains the MySQL DSN used by the isolated E08 Hooke release.

CONFIRM_KUBE_CONTEXT=no
CONFIRM_E08_EXECUTION=no
REQUIRE_CLEAN_GIT=true

KUBECONFIG_PATH=/absolute/path/to/ack.kubeconfig
KUBE_CONTEXT=replace-with-ack-context
EXPECTED_API_SERVER_SUBSTRING=replace-with-ack-api-identity
CLUSTER_ID=replace-with-logical-cluster-id

# Exactly two Ready, schedulable physical ACK Worker node names. Every cell
# uses these same nodes.
E08_TARGET_NODES=worker-a,worker-b

# Build and push with `make e08-image-push`, then copy the emitted digest here.
E08_IMAGE_METADATA_FILE=dist/e08-image.env
E08_IMAGE=registry.example.com/hooke/e08@sha256:replace-with-64-hex-digest

# Existing MySQL reachable from Pods in the ACK VPC. Do not commit this value.
HOOKE_MYSQL_DSN='hooke:replace-me@tcp(mysql.example.internal:3306)/hooke?parseTime=true&multiStatements=true'

E08_SYSTEM_NAMESPACE=hooke-e08-system
E08_HELM_RELEASE=hooke-e08
E08_MYSQL_SECRET=hooke-e08-mysql
E08_LOCK_NAMESPACE=kube-system
E08_LOCK_NAME=hooke-e08-collector-overhead

# Low-rate smoke settings. Parallelism is intentionally frozen at two.
E08_POD_COUNT=50
E08_PARALLELISM=2
E08_WORK_DURATION=5s
E08_WORKLOAD_CPU=25m
E08_WORKLOAD_MEMORY=32Mi
E08_JOB_TIMEOUT_SECONDS=900
E08_RESOURCE_SAMPLE_INTERVAL_SECONDS=1
E08_COLLECTOR_SETTLE_SECONDS=5

ARTIFACT_ROOT=artifacts
CLEANUP_K8S_ON_SUCCESS=true
CLEANUP_K8S_ON_ERROR=true
