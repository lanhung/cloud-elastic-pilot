# Copy to configs/gpu-dra-mig.env. The real file is gitignored because it
# contains the MySQL DSN used by the isolated E09 Hooke release.

CONFIRM_KUBE_CONTEXT=no
CONFIRM_E09_EXECUTION=no
CONFIRM_MIG_RECONFIGURATION=no
REQUIRE_CLEAN_GIT=true

KUBECONFIG_PATH=/absolute/path/to/ack.kubeconfig
KUBE_CONTEXT=replace-with-ack-context
EXPECTED_API_SERVER_SUBSTRING=replace-with-ack-api-identity
CLUSTER_ID=replace-with-logical-cluster-id

# One dedicated, full physical A100 Worker. Do not use a pre-sliced vGPU.
E09_TARGET_NODE=replace-with-a100-worker-name
E09_GPU_PRODUCT_REGEX='A100'

# The source must be the current successful node label. The target depends on
# A100 memory size and the GPU Operator's generated/supplied MIG config:
# A100 40 GB commonly uses all-1g.5gb; A100 80 GB commonly uses all-1g.10gb.
E09_MIG_SOURCE_PROFILE=all-disabled
E09_MIG_TARGET_PROFILE=all-1g.5gb
E09_DEVICE_CLASS=mig.nvidia.com
E09_DRA_DRIVER=gpu.nvidia.com

# Build and push with `make e09-images-push`, then copy both emitted digests.
E09_IMAGE_METADATA_FILE=dist/e09-images.env
E09_STACK_IMAGE=registry.example.com/hooke/e09-stack@sha256:replace-with-64-hex-digest
E09_PROBE_IMAGE=registry.example.com/hooke/e09-probe@sha256:replace-with-64-hex-digest

# These are build inputs, not cluster installation versions. Resolve official
# NVIDIA CUDA images to exact per-platform digests before building.
E09_CUDA_DEVEL_IMAGE=nvcr.io/nvidia/cuda@sha256:replace-with-64-hex-digest
E09_CUDA_RUNTIME_IMAGE=nvcr.io/nvidia/cuda@sha256:replace-with-64-hex-digest

HOOKE_MYSQL_DSN='hooke:replace-me@tcp(mysql.example.internal:3306)/hooke?parseTime=true&multiStatements=true'

E09_SYSTEM_NAMESPACE=hooke-e09-system
E09_WORKLOAD_NAMESPACE=hooke-e09-smoke
E09_HELM_RELEASE=hooke-e09
E09_MYSQL_SECRET=hooke-e09-mysql
E09_LOCK_NAMESPACE=kube-system
E09_LOCK_NAME=hooke-e09-gpu-dra-mig

# Keep the Hooke control plane on the fixed CPU pool throughout the reshape.
E09_CONTROL_NODE_SELECTOR_KEY=hooke.io/pool
E09_CONTROL_NODE_SELECTOR_VALUE=fixed-cpu

# Protective taint already present on the GPU node. The runner verifies it and
# adds only the matching toleration to the CUDA probe.
E09_GPU_TAINT_KEY=nvidia.com/gpu
E09_GPU_TAINT_VALUE=
E09_GPU_TAINT_EFFECT=NoSchedule

# Component locations/selectors vary by ACK installation. Each selector must
# resolve to exactly one Ready Pod on E09_TARGET_NODE.
E09_GPU_OPERATOR_NAMESPACE=gpu-operator
E09_DRIVER_POD_SELECTOR=app=nvidia-driver-daemonset
E09_DRIVER_CONTAINER=nvidia-driver-ctr
E09_MIG_MANAGER_NAMESPACE=gpu-operator
E09_MIG_MANAGER_POD_SELECTOR=app=nvidia-mig-manager
E09_MIG_MANAGER_CONTAINER=nvidia-mig-manager
E09_DRA_NAMESPACE=nvidia-dra-driver-gpu
# NVIDIA DRA chart v0.4.1 default. A v25.x release upgraded with nameOverride
# may instead use nvidia-dra-driver-gpu-component=kubelet-plugin.
E09_DRA_POD_SELECTOR=dra-driver-nvidia-gpu-component=kubelet-plugin
E09_DRA_CONTAINER=gpus
E09_DRA_NODE_LABEL_KEY=nvidia.com/dra-kubelet-plugin
E09_DRA_NODE_LABEL_VALUE=true

# The legacy NVIDIA Device Plugin must be disabled on the target because this
# smoke allocates exclusively through DRA.
E09_DEVICE_PLUGIN_NAMESPACE=gpu-operator
E09_DEVICE_PLUGIN_POD_SELECTOR=app=nvidia-device-plugin-daemonset

# Optional Kubernetes service-proxy path for a DCGM Prometheus snapshot.
# Example shape:
# /api/v1/namespaces/gpu-operator/services/http:nvidia-dcgm-exporter:9400/proxy/metrics
E09_DCGM_METRICS_API_PATH=

E09_CONTROLLER_SETTLE_SECONDS=5
E09_MIG_TIMEOUT_SECONDS=1200
E09_DRA_RESTART_TIMEOUT_SECONDS=300
E09_POD_TIMEOUT_SECONDS=600
E09_CLAIM_SETTLE_SECONDS=5

# Safety default: restore the source MIG profile on success and failure. A
# failed restoration preserves the Lease for manual review.
E09_RESTORE_MIG_PROFILE=true
ARTIFACT_ROOT=artifacts
CLEANUP_K8S_ON_SUCCESS=true
CLEANUP_K8S_ON_ERROR=true
