# E05 ACK Kube Queue gang pilot. Copy to configs/kube-queue-gang.env and
# replace every real placeholder before running the read-only preflight.

# -------------------- target and safety --------------------
CONFIRM_KUBE_CONTEXT="no"
CONFIRM_E05_EXECUTION="no"
REQUIRE_CLEAN_GIT="true"
EXPECTED_API_SERVER_SUBSTRING="replace-with-ack-api-host-fragment"
KUBECONFIG_PATH="$HOME/.kube/config"
KUBE_CONTEXT=""
CLUSTER_ID="ack-e05-pilot"
ARTIFACT_ROOT="artifacts"

# -------------------- ACK Kube Queue installation --------------------
KUBE_QUEUE_NAMESPACE="kube-queue"
KUBE_QUEUE_RELEASE="ack-kube-queue"
KUBE_QUEUE_CHART_VERSION="1.26.3"

# -------------------- frozen pilot design --------------------
# Each randomized block contains n=2/4 crossed with k=n/ceil(n/2).
# ACK Kube Queue always admits all n Pods; k only controls the app barrier.
E05_PILOT_REPETITIONS="5"
E05_RANDOM_SEED="20260724"
E05_MEMBER_COUNTS="2,4"
E05_SAMPLE_INTERVAL_SECONDS="0.5"
E05_JOB_TIMEOUT_SECONDS="900"
E05_BARRIER_TIMEOUT="10m"
E05_WORK_DURATION="10s"
E05_LEADER_GRACE_DURATION="60s"

# -------------------- immutable image --------------------
# Build and push after committing the adaptation:
# make e05-image-push IMAGE_REPOSITORY=<same-region-acr-repository>
E05_IMAGE_METADATA_FILE="dist/e05-image.env"
E05_APP_IMAGE="registry.example.com/hooke/e05@sha256:replace"

# -------------------- fixed capacity --------------------
# E05 isolates queue/barrier behavior from node provisioning.
E05_NODE_SELECTOR_KEY="kubernetes.io/hostname"
E05_NODE_SELECTOR_VALUE="replace-with-ready-node-name"
E05_TAINT_KEY=""
E05_TAINT_VALUE=""
E05_TAINT_EFFECT="NoSchedule"

# -------------------- worker and queue resources --------------------
E05_WORKER_CPU_REQUEST="250m"
E05_WORKER_CPU_LIMIT="250m"
E05_WORKER_MEMORY_REQUEST="64Mi"
E05_WORKER_MEMORY_LIMIT="64Mi"

# The single, temporary ElasticQuotaTree allows one whole Job at a time and
# must cover max(n) workers. The runner refuses to replace an existing tree.
E05_QUOTA_CPU="2"
E05_QUOTA_MEMORY="1Gi"
E05_QUOTA_MAX_JOBS="1"

# -------------------- cleanup --------------------
CLEANUP_K8S_ON_SUCCESS="true"
CLEANUP_K8S_ON_ERROR="true"
