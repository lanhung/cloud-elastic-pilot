# E06 Argo Workflow critical-path smoke. Copy to configs/argo-workflow.env and
# replace every real placeholder before running the read-only preflight.

# -------------------- target and safety --------------------
CONFIRM_KUBE_CONTEXT="no"
CONFIRM_E06_EXECUTION="no"
REQUIRE_CLEAN_GIT="true"
EXPECTED_API_SERVER_SUBSTRING="replace-with-ack-api-host-fragment"
KUBECONFIG_PATH="$HOME/.kube/config"
KUBE_CONTEXT=""
CLUSTER_ID="ack-e06-smoke"
ARTIFACT_ROOT="artifacts"

# -------------------- ACK Argo Workflows installation --------------------
ARGO_NAMESPACE="argo"
ARGO_RELEASE="ack-workflow"
ARGO_CHART_VERSION="3.5.15"
ARGO_CONTROLLER_DEPLOYMENT="ack-workflow-controller"
ARGO_CONTROLLER_VERSION_PREFIX="v3.5.13"
E06_WORKFLOW_SERVICE_ACCOUNT="e06-workflow"

# -------------------- frozen smoke design --------------------
# One randomized paired block is the smoke scope. A statistical Pilot would
# use at least 30 pairs and is explicitly out of scope for this run.
E06_REPETITIONS="1"
E06_RANDOM_SEED="20260727"
E06_STAGE_DURATIONS="a=2s,b=6s,c=4s,d=2s,e=1s,f=1s"
E06_SAMPLE_INTERVAL_SECONDS="0.5"
E06_STAGE_TIMEOUT_SECONDS="120"
E06_WORKFLOW_TIMEOUT_SECONDS="600"
E06_SLO_SECONDS="30"
E06_CLOCK_TOLERANCE_SECONDS="2"

# -------------------- immutable image --------------------
# Build and push after committing the adaptation:
# make e06-image-push IMAGE_REPOSITORY=<same-region-acr-repository>
E06_IMAGE_METADATA_FILE="dist/e06-image.env"
E06_APP_IMAGE="registry.example.com/hooke/e06@sha256:replace"

# -------------------- fixed physical node --------------------
# E06 isolates DAG structure from Node provisioning. Use an exact physical
# kubernetes.io/hostname value, never a virtual-kubelet node.
E06_NODE_SELECTOR_KEY="kubernetes.io/hostname"
E06_NODE_SELECTOR_VALUE="replace-with-ready-physical-node-name"
E06_TAINT_KEY=""
E06_TAINT_VALUE=""
E06_TAINT_EFFECT="NoSchedule"
E06_MIN_FREE_CPU_MILLICORES="300"
E06_MIN_FREE_MEMORY_MIB="256"

# -------------------- stage resources --------------------
# Keep requests small because ACK system add-ons reserve most allocatable
# memory on the current 4C/4G workers. Tuned runs at most B and C concurrently.
E06_WORKER_CPU_REQUEST="50m"
E06_WORKER_CPU_LIMIT="100m"
E06_WORKER_MEMORY_REQUEST="32Mi"
E06_WORKER_MEMORY_LIMIT="64Mi"

# -------------------- cleanup --------------------
CLEANUP_K8S_ON_SUCCESS="true"
CLEANUP_K8S_ON_ERROR="true"
